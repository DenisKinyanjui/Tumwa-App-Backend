# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────────────────
# IMPORTANT: Replace this with the standard (non-SRV) connection string from Atlas.
# Atlas → Connect → Drivers → enable "driver that does not support +srv" toggle → copy string.
# The +srv URI below causes querySrv ECONNREFUSED on many local networks.
MONGO_URI=mongodb://bluetechfirmkenya_db_user:Tumwa001@ac-8ky9ylv-shard-00-00.dimb1b5.mongodb.net:27017,ac-8ky9ylv-shard-00-01.dimb1b5.mongodb.net:27017,ac-8ky9ylv-shard-00-02.dimb1b5.mongodb.net:27017/tumwa?ssl=true&replicaSet=atlas-ey2o9o-shard-0&authSource=admin&appName=Cluster0
# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=tumwa_access_secret_change_in_production_2024
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tumwa_refresh_secret_change_in_production_2024
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_MAX_AGE=2592000

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:5173
CLIENT_ORIGIN=http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=20
RATE_LIMIT_API=200
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_PAYMENT=5
RATE_LIMIT_ADMIN=100

# ── Redis (optional) ───────────────────────────────────────────────────────────
# Leave blank or comment out — server falls back to in-memory if Redis is unavailable
# REDIS_URL=redis://localhost:6379

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── M-Pesa (sandbox) ───────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_B2C_SHORTCODE=600999
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=your_security_credential
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io
MPESA_ENFORCE_CALLBACK_IP=false

# ── Firebase FCM (optional — leave blank to disable push notifications) ────────
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
