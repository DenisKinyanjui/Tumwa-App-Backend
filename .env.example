# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development                    # development | production

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tumwa

# ── JWT — Access Token (short-lived) ─────────────────────────────────────────
JWT_SECRET=your_super_secret_access_key_change_this_in_production
JWT_ACCESS_EXPIRES_IN=15m              # recommended: 15m in production

# ── JWT — Refresh Token (long-lived, stored as httpOnly cookie) ───────────────
JWT_REFRESH_SECRET=your_super_secret_refresh_key_must_differ_from_access
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_MAX_AGE=2592000     # 30 days in seconds

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (web clients / admin dashboard)
# Mobile app requests have no Origin header and are always allowed
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ── Socket.io ─────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
RUNNER_NOTIFY_RADIUS_KM=10

# ── Rate Limiting (requests per window per IP) ────────────────────────────────
RATE_LIMIT_AUTH=20                     # login + register (per 15 min)
RATE_LIMIT_API=200                     # general API (per 15 min)
RATE_LIMIT_SENSITIVE=10                # refresh token + password change (per hour)
RATE_LIMIT_PAYMENT=5                   # payment initiation (per 10 min)
RATE_LIMIT_ADMIN=100                   # admin panel (per 15 min)

# ── Redis (optional — enables caching and shared rate-limit store) ────────────
# Leave blank to run without Redis (graceful fallback to in-memory)
REDIS_URL=redis://localhost:6379

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                         # error | warn | info | debug

# ── M-Pesa Daraja API ─────────────────────────────────────────────────────────
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox              # sandbox | production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# STK Push (Lipa Na M-Pesa Online)
MPESA_SHORTCODE=174379                 # sandbox test shortcode
MPESA_PASSKEY=your_lipa_na_mpesa_passkey

# B2C (runner withdrawals)
MPESA_B2C_SHORTCODE=600999             # sandbox B2C shortcode
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=your_security_credential

# Public URL that Safaricom can reach for callbacks
# Use ngrok in development: ngrok http 3000
MPESA_CALLBACK_URL=https://your-public-domain.com

# M-Pesa callback IP validation (set to true in production)
MPESA_ENFORCE_CALLBACK_IP=false
# Override default Safaricom IP allowlist (comma-separated) if needed
# MPESA_CALLBACK_IPS=196.201.214.200,196.201.214.206

# ── Firebase Cloud Messaging (FCM) — push notifications ──────────────────────
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
# Leave blank to disable push notifications (socket + DB notifications still work)
FCM_PROJECT_ID=your_firebase_project_id
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
